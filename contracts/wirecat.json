{
  "wcat_manifest": 2,
  "name": "slack",
  "description": "a new WireCat CLI, started from cli-template",
  "docs_url": "https://github.com/WireCatLabs/slack-cli#readme",
  "package": "@wirecat/slack-cli",
  "bin": "wcat-slack",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "summary": "every command by section; --json prints its contract, one path per call",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "summary": "one command contract, or all schemas, error reasons and explicit overrides",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "summary": "sign in to Slack Web with an API token",
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "summary": "show where this profile's token comes from; never the token",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "summary": "forget this profile's token on this computer",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "summary": "list the profiles here and whether each is signed in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "api",
        "list"
      ],
      "summary": "list every Slack Web API operation this CLI offers, without calling Slack Web",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "permission": "api.list",
      "entity": "api_operation"
    },
    {
      "path": [
        "api",
        "show"
      ],
      "summary": "show one operation's parameters and request schema, without calling Slack Web",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "permission": "api.show"
    },
    {
